# =============================================
# Alpha Portfolio Tracker - Environment Variables
# =============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local

# ===========================================
# DATABASE (Required)
# ===========================================
# --- Option A: Vercel Marketplace (recommended for Vercel deployments) ---
# Connect Turso via Vercel Storage → Connect Database → Turso.
# Vercel will automatically inject TURSO_DATABASE_URL and TURSO_AUTH_TOKEN.
# No further action needed — the app reads TURSO_DATABASE_URL automatically.
#
# --- Option B: Manual setup (CLI or Turso dashboard) ---
# Sign up at https://turso.tech, then run:
#   turso db create alpha-portfolio
#   turso db show alpha-portfolio --url        # → DATABASE_URL
#   turso db tokens create alpha-portfolio     # → TURSO_AUTH_TOKEN
DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# ===========================================
# UPSTOX API (Required)
# ===========================================
# Analytics Token — long-lived (1-year), read-only, no OAuth needed
# Generate at: https://developer.upstox.com → Developer Apps → Analytics tab
UPSTOX_ANALYTICS_TOKEN=your-analytics-token

# ===========================================
# CRON JOB SECURITY (Strongly Recommended)
# ===========================================
# Protects all /api/cron/* and /api/recompute endpoints.
# Any random string works. Pass as ?secret=YOUR_SECRET in cron-job.org URLs.
# Without this, cron endpoints accept any request in production.
CRON_SECRET=your-random-secret-string

# ===========================================
# PERSONALIZATION (Optional)
# ===========================================
# Your name displayed in the UI (defaults to 'User')
# APP_USER_NAME=YourName
# NEXT_PUBLIC_APP_USER_NAME=YourName

# Cache buster for React Query persistent storage.
# Increment (e.g. v2, v3) whenever you want to invalidate stale client-side cache.
# NEXT_PUBLIC_APP_VERSION=v1

# ===========================================
# DATA LOCK (Optional)
# ===========================================
# Env-level fallback for the data lock date (YYYY-MM-DD).
# Normally set via Settings UI (stored in DB); this overrides that.
# DATA_LOCK_DATE=2024-01-01

# ===========================================
# DEVELOPMENT FLAGS (Optional)
# ===========================================
# Set to "false" to disable all Upstox API calls (useful for offline testing).
# Defaults to true.
# USE_UPSTOX=false

# ===========================================
# ZERODHA KITE (Optional — for order sync)
# ===========================================
# Only needed if using the Zerodha order sync feature.
# See README → "Zerodha Kite Integration" for the full setup guide.
#
# IMPORTANT: ZERODHA_TOTP_SECRET is the raw TOTP secret key,
# NOT the 6-digit code. Find it when setting up 2FA by choosing
# "authenticator app" and revealing/copying the secret key.
#
# ZERODHA_USER_ID=your-zerodha-client-id
# ZERODHA_PASSWORD=your-zerodha-password
# ZERODHA_TOTP_SECRET=your-raw-totp-secret
# ZERODHA_API_KEY=your-kite-api-key
# ZERODHA_API_SECRET=your-kite-api-secret

# ===========================================
# GITHUB ACTIONS — Zerodha Sync Dispatch (Optional)
# ===========================================
# Required to trigger the Zerodha sync GitHub Action from the Settings page.
# Create a PAT at: GitHub → Settings → Developer settings → Personal access tokens (classic)
# Required scope: workflow
# GITHUB_PAT=your-github-personal-access-token

# Only needed if NOT deployed on Vercel (Vercel auto-injects these).
# GITHUB_REPO_OWNER=your-github-username
# GITHUB_REPO_NAME=Alpha

# ===========================================
# DAILY EMAIL REPORT (Optional)
# ===========================================
# Sends a daily portfolio + screener summary email after market close.
# Requires setting up cron job: GET /api/cron/daily-report at 0 11 * * 1-5 UTC
# Sign up for Resend at: https://resend.com
#
# RESEND_API_KEY=re_your-resend-api-key
# REPORT_EMAIL_TO=you@example.com
# REPORT_EMAIL_FROM=portfolio@yourdomain.com   # Defaults to onboarding@resend.dev (sandbox)

# AI summary in email (optional — requires Groq account at https://groq.com)
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile           # Default model if not set
