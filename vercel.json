{
  "functions": {
    "src/app/api/**": {
      "maxDuration": 60
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/momentum-screener",
      "schedule": "30 10 * * 1-5"
    },
    {
      "path": "/api/cron/bhavcopy",
      "schedule": "0 6 * * 6"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 11 * * 1-5"
    }
  ]
}
