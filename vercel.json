{
  "functions": {
    "src/app/api/**": {
      "maxDuration": 60
    },
    "src/app/api/cron/**": {
      "maxDuration": 300
    },
    "src/app/api/admin/**": {
      "maxDuration": 300
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/sync-orders",
      "schedule": "10 10 * * 1-5"
    },
    {
      "path": "/api/cron/momentum-screener",
      "schedule": "15 10 * * 1-5"
    },
    {
      "path": "/api/cron/bhavcopy",
      "schedule": "0 6 * * 6"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "15 11 * * 1-5"
    }
  ]
}
